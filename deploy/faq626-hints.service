[Unit]
Description=faq626 auto-hints for the «Лиды» tab (GigaChat)
After=network-online.target faq626.service
Wants=network-online.target

[Service]
Type=oneshot
User=faq626
WorkingDirectory=/opt/faq626
# BITRIX_WEBHOOK, DASHBOARD_*; the GigaChat key lives in its own file
EnvironmentFile=/etc/faq626.env
EnvironmentFile=/etc/faq626-gigachat.env
Environment=PORT=3000 NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/russian_trusted_ca.crt
ExecStart=/usr/bin/node hints-auto.js
TimeoutStartSec=20min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
